# Pollinations AI API Key (Required for text/chat)
# Get your free API key from: https://enter.pollinations.ai
# This key is used for text generation with gemini-search and reasoning with nova-fast
API_KEY=your_pollinations_api_key_here
# Or use the VITE_ prefix for Vite build:
# VITE_API_KEY=your_pollinations_api_key_here

# Google Gemini API Key (Optional - used as fallback)
# Get from: https://aistudio.google.com/app/apikey
# This is only used if Pollinations API fails
GEMINI_API_KEY=your_gemini_api_key_here
# Or use the VITE_ prefix:
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Note for Supabase Functions:
# Image generation uses a separate 'new_api' environment variable
# Set this in your Supabase project settings under Edge Functions
# new_api=your_pollinations_api_key_here
